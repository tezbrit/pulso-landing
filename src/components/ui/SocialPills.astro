---
const {href} = Astro.props;
---

<a 
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-x-2 px-4 py-2 rounded-full border border-white/20 bg-white/5 hover:scale-150 transition-all duration-300 text-sm md:text-base text-gray-200 hover:text-white backdrop-blur-sm">
    <slot />
</a>